# ---------------------------------------------------------------------------
# Desenvolvimento local: pode deixar tudo abaixo vazio (usa SQLite e a pasta media/)
# ---------------------------------------------------------------------------
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Só necessário para rodar o Flutter na web
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Supabase (banco) — string do botão "Connect" do painel
#  - Local (migrate / createsuperuser): "Session pooler"     (porta 5432)
#  - Vercel (variável de ambiente):     "Transaction pooler" (porta 6543)
# Se a senha tiver @ # / etc., codifique na URL (@ vira %40).
# ---------------------------------------------------------------------------
DATABASE_URL= 

# Postgres próprio (alternativa ao DATABASE_URL)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ---------------------------------------------------------------------------
# Supabase Storage (fotos) — Storage > configuração S3
# Preencha SUPABASE_S3_ACCESS_KEY para ativar; vazio = fotos na pasta media/
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_BUCKET=fotos
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Só na Vercel
# ---------------------------------------------------------------------------
CSRF_TRUSTED_ORIGINS=
